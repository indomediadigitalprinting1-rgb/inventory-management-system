rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection probe endpoint for client startup validation
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // -------------------------------------------------------------------------
    // Core Helper Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isBootstrappedOwner() {
      return isVerified() && request.auth.token.email == 'garasikosong2205@gmail.com';
    }

    function isOwner() {
      return isBootstrappedOwner() ||
        (isVerified() && hasUserDoc() && userDoc().active == true && userDoc().role == 'OWNER');
    }

    function isAdmin() {
      return isVerified() && hasUserDoc() && userDoc().active == true && userDoc().role == 'ADMIN';
    }

    function isProduksi() {
      return isVerified() && hasUserDoc() && userDoc().active == true && userDoc().role == 'PRODUKSI';
    }

    function isManager() {
      return isOwner() || isAdmin();
    }

    function isActiveStaff() {
      return isOwner() || isAdmin() || isProduksi();
    }

    function myInviteId() {
      return request.auth.token.email.lower().replace('[^a-z0-9_-]', '_');
    }

    function hasActiveAdminInvite() {
      return isVerified()
        && exists(/databases/$(database)/documents/userInvites/$(myInviteId()))
        && get(/databases/$(database)/documents/userInvites/$(myInviteId())).data.active == true
        && get(/databases/$(database)/documents/userInvites/$(myInviteId())).data.role == 'ADMIN'
        && get(/databases/$(database)/documents/userInvites/$(myInviteId())).data.email.lower() == request.auth.token.email.lower();
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (isValid[Entity])
    // -------------------------------------------------------------------------
    function isValidSystemConfig(data) {
      return data.keys().hasAll(['initialized', 'ownerUid', 'ownerEmail', 'companyName', 'lowStockAlertEnabled', 'updatedAt'])
        && data.keys().hasOnly(['initialized', 'ownerUid', 'ownerEmail', 'companyName', 'lowStockAlertEnabled', 'updatedAt'])
        && data.initialized is bool
        && data.ownerUid is string && data.ownerUid.size() <= 128 && isValidId(data.ownerUid)
        && data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 200
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 160
        && data.lowStockAlertEnabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidAdminSlot(data) {
      return data.keys().hasAll(['occupied', 'adminUid', 'adminEmail', 'updatedAt'])
        && data.keys().hasOnly(['occupied', 'adminUid', 'adminEmail', 'updatedAt'])
        && data.occupied is bool
        && (data.adminUid == null || (data.adminUid is string && data.adminUid.size() <= 128))
        && (data.adminEmail == null || (data.adminEmail is string && data.adminEmail.size() <= 200))
        && data.updatedAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'department', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'role', 'department', 'active', 'inviteId', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role in ['OWNER', 'ADMIN', 'PRODUKSI']
        && data.department is string && data.department.size() <= 80
        && data.active is bool
        && (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserInvite(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'department', 'active', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'name', 'role', 'department', 'active', 'claimedUid', 'createdByUid', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role in ['ADMIN', 'PRODUKSI']
        && data.department is string && data.department.size() <= 80
        && data.active is bool
        && (!('claimedUid' in data) || data.claimedUid == null || (data.claimedUid is string && data.claimedUid.size() <= 128))
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'name', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 300
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUnit(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'name', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 24
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 300
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'contactPerson', 'phone', 'email', 'address', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'name', 'contactPerson', 'phone', 'email', 'address', 'active', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.contactPerson is string && data.contactPerson.size() <= 100
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 160
        && data.address is string && data.address.size() <= 400
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidItem(data) {
      return data.keys().hasAll([
        'id', 'code', 'barcode', 'name', 'categoryId', 'categoryName',
        'specification', 'unitId', 'unitName', 'initialStock', 'currentStock',
        'minStock', 'purchasePrice', 'supplierId', 'supplierName',
        'active', 'hasTransactions', 'createdByUid', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
        'id', 'code', 'barcode', 'name', 'categoryId', 'categoryName',
        'specification', 'unitId', 'unitName', 'initialStock', 'currentStock',
        'minStock', 'purchasePrice', 'supplierId', 'supplierName',
        'active', 'hasTransactions', 'createdByUid', 'createdAt', 'updatedAt'
      ])
        && data.id is string && isValidId(data.id)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.categoryId is string && isValidId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 100
        && data.specification is string && data.specification.size() <= 500
        && data.unitId is string && isValidId(data.unitId)
        && data.unitName is string && data.unitName.size() >= 1 && data.unitName.size() <= 80
        && data.initialStock is number && data.initialStock >= 0
        && data.currentStock is number && data.currentStock >= 0
        && data.minStock is number && data.minStock >= 0
        && data.purchasePrice is number && data.purchasePrice >= 0
        && data.supplierId is string && isValidId(data.supplierId)
        && data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 140
        && data.active is bool
        && data.hasTransactions is bool
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUniqueCodeLock(data) {
      return data.keys().hasAll(['itemId', 'value', 'createdAt'])
        && data.keys().hasOnly(['itemId', 'value', 'createdAt'])
        && data.itemId is string && isValidId(data.itemId)
        && data.value is string && data.value.size() >= 1 && data.value.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidIncomingTransaction(data) {
      return data.keys().hasAll([
        'id', 'txNumber', 'date', 'supplierId', 'supplierName', 'items',
        'totalAmount', 'notes', 'status', 'idempotencyKey',
        'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
        'id', 'txNumber', 'date', 'supplierId', 'supplierName', 'items',
        'totalAmount', 'notes', 'status', 'reversalOfId', 'idempotencyKey',
        'createdByUid', 'createdByName', 'confirmedByUid', 'confirmedByName',
        'confirmedAt', 'createdAt', 'updatedAt'
      ])
        && data.id is string && isValidId(data.id)
        && data.txNumber is string && data.txNumber.size() >= 1 && data.txNumber.size() <= 64
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 32
        && data.supplierId is string && isValidId(data.supplierId)
        && data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 140
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.totalAmount is number && data.totalAmount >= 0
        && data.notes is string && data.notes.size() <= 500
        && data.status in ['DRAFT', 'CONFIRMED', 'REVERSED']
        && (!('reversalOfId' in data) || data.reversalOfId == null || (data.reversalOfId is string && isValidId(data.reversalOfId)))
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 128
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && (!('confirmedByUid' in data) || data.confirmedByUid == null || (data.confirmedByUid is string && isValidId(data.confirmedByUid)))
        && (!('confirmedByName' in data) || data.confirmedByName == null || (data.confirmedByName is string && data.confirmedByName.size() <= 120))
        && (!('confirmedAt' in data) || data.confirmedAt == null || data.confirmedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockRequest(data) {
      return data.keys().hasAll([
        'id', 'requestNumber', 'requesterUid', 'requesterName', 'department',
        'notes', 'status', 'items', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
        'id', 'requestNumber', 'requesterUid', 'requesterName', 'department',
        'notes', 'status', 'items', 'approvedByUid', 'approvedByName',
        'approvedAt', 'rejectionReason', 'createdAt', 'updatedAt'
      ])
        && data.id is string && isValidId(data.id)
        && data.requestNumber is string && data.requestNumber.size() >= 1 && data.requestNumber.size() <= 64
        && data.requesterUid is string && isValidId(data.requesterUid)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
        && data.department is string && data.department.size() <= 80
        && data.notes is string && data.notes.size() <= 500
        && data.status in [
          'MENUNGGU_PERSETUJUAN', 'DISETUJUI', 'DITOLAK',
          'SIAP_DIAMBIL', 'DALAM_PROSES_PENGAMBILAN', 'SELESAI', 'DIBATALKAN'
        ]
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && (!('approvedByUid' in data) || data.approvedByUid == null || (data.approvedByUid is string && isValidId(data.approvedByUid)))
        && (!('approvedByName' in data) || data.approvedByName == null || (data.approvedByName is string && data.approvedByName.size() <= 120))
        && (!('approvedAt' in data) || data.approvedAt == null || data.approvedAt is timestamp)
        && (!('rejectionReason' in data) || data.rejectionReason == null || (data.rejectionReason is string && data.rejectionReason.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeliveryRecord(data) {
      return data.keys().hasAll([
        'id', 'deliveryNumber', 'stockOutNumber', 'requestId', 'requestNumber',
        'requesterUid', 'requesterName', 'items', 'notes',
        'deliveredByUid', 'deliveredByName', 'idempotencyKey', 'createdAt'
      ])
        && data.keys().hasOnly([
        'id', 'deliveryNumber', 'stockOutNumber', 'requestId', 'requestNumber',
        'requesterUid', 'requesterName', 'items', 'notes',
        'deliveredByUid', 'deliveredByName', 'idempotencyKey', 'createdAt'
      ])
        && data.id is string && isValidId(data.id)
        && data.deliveryNumber is string && data.deliveryNumber.size() >= 1 && data.deliveryNumber.size() <= 64
        && data.stockOutNumber is string && data.stockOutNumber.size() >= 1 && data.stockOutNumber.size() <= 64
        && data.requestId is string && isValidId(data.requestId)
        && data.requestNumber is string && data.requestNumber.size() >= 1 && data.requestNumber.size() <= 64
        && data.requesterUid is string && isValidId(data.requesterUid)
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.notes is string && data.notes.size() <= 500
        && data.deliveredByUid is string && isValidId(data.deliveredByUid)
        && data.deliveredByName is string && data.deliveredByName.size() >= 1 && data.deliveredByName.size() <= 120
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidStockAdjustment(data) {
      return data.keys().hasAll([
        'id', 'txNumber', 'itemId', 'itemCode', 'itemName', 'type',
        'previousStock', 'qtyChange', 'newStock', 'reason',
        'idempotencyKey', 'createdByUid', 'createdByName', 'createdAt'
      ])
        && data.keys().hasOnly([
        'id', 'txNumber', 'itemId', 'itemCode', 'itemName', 'type',
        'previousStock', 'qtyChange', 'newStock', 'reason',
        'idempotencyKey', 'createdByUid', 'createdByName', 'createdAt'
      ])
        && data.id is string && isValidId(data.id)
        && data.txNumber is string && data.txNumber.size() >= 1 && data.txNumber.size() <= 64
        && data.itemId is string && isValidId(data.itemId)
        && data.itemCode is string && data.itemCode.size() >= 1 && data.itemCode.size() <= 64
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 180
        && data.type in ['INCREASE', 'DECREASE', 'OPNAME']
        && data.previousStock is number && data.previousStock >= 0
        && data.qtyChange is number
        && data.newStock is number && data.newStock >= 0
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 400
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 128
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidStockLedgerEntry(data) {
      return data.keys().hasAll([
        'id', 'date', 'txNumber', 'txType', 'referenceId', 'itemId',
        'itemCode', 'itemName', 'categoryName', 'unitName', 'qtyIn', 'qtyOut',
        'balanceAfter', 'notes', 'userId', 'userName', 'createdAt'
      ])
        && data.keys().hasOnly([
        'id', 'date', 'txNumber', 'txType', 'referenceId', 'itemId',
        'itemCode', 'itemName', 'categoryName', 'unitName', 'qtyIn', 'qtyOut',
        'balanceAfter', 'notes', 'userId', 'userName', 'createdAt'
      ])
        && data.id is string && isValidId(data.id)
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 32
        && data.txNumber is string && data.txNumber.size() >= 1 && data.txNumber.size() <= 64
        && data.txType in ['MASUK', 'KELUAR', 'PENYESUAIAN', 'PEMBALIK']
        && data.referenceId is string && isValidId(data.referenceId)
        && data.itemId is string && isValidId(data.itemId)
        && data.itemCode is string && data.itemCode.size() >= 1 && data.itemCode.size() <= 64
        && data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 180
        && data.categoryName is string && data.categoryName.size() <= 100
        && data.unitName is string && data.unitName.size() <= 80
        && data.qtyIn is number && data.qtyIn >= 0
        && data.qtyOut is number && data.qtyOut >= 0
        && data.balanceAfter is number && data.balanceAfter >= 0
        && data.notes is string && data.notes.size() <= 500
        && data.userId is string && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'targetRole', 'type', 'title', 'message', 'readBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'targetRole', 'targetUid', 'type', 'title', 'message', 'linkView', 'relatedId', 'readBy', 'readAtBy', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.targetRole in ['OWNER', 'ADMIN', 'PRODUKSI']
        && (!('targetUid' in data) || data.targetUid == null || (data.targetUid is string && data.targetUid.size() <= 128))
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 400
        && (!('linkView' in data) || data.linkView == null || (data.linkView is string && data.linkView.size() <= 64))
        && (!('relatedId' in data) || data.relatedId == null || (data.relatedId is string && data.relatedId.size() <= 128))
        && data.readBy is list && data.readBy.size() <= 50
        && (data.readBy.size() == 0 || data.readBy[0] is string)
        && (!('readAtBy' in data) || (data.readAtBy is map && data.readAtBy.size() <= 50))
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'description', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'description', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.actorUid is string && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.actorRole in ['OWNER', 'ADMIN', 'PRODUKSI']
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 64
        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidIdempotencyKey(data) {
      return data.keys().hasAll(['key', 'operation', 'actorUid', 'createdAt'])
        && data.keys().hasOnly(['key', 'operation', 'actorUid', 'createdAt'])
        && data.key is string && isValidId(data.key)
        && data.operation is string && data.operation.size() >= 1 && data.operation.size() <= 64
        && data.actorUid is string && isValidId(data.actorUid)
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /system/{docId} {
      allow get: if isVerified() && docId in ['config', 'adminSlot'];

      allow create: if isVerified() && (
        (docId == 'config'
          && isValidSystemConfig(incoming())
          && incoming().ownerUid == request.auth.uid
          && incoming().ownerEmail.lower() == request.auth.token.email.lower()
          && incoming().updatedAt == request.time
          && !exists(/databases/$(database)/documents/system/config))
        ||
        (docId == 'adminSlot'
          && isValidAdminSlot(incoming())
          && incoming().updatedAt == request.time
          && !exists(/databases/$(database)/documents/system/adminSlot)
          && (
            isOwner()
            || (
              !exists(/databases/$(database)/documents/system/config)
              && existsAfter(/databases/$(database)/documents/system/config)
              && getAfter(/databases/$(database)/documents/system/config).data.ownerUid == request.auth.uid
              && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER'
            )
            || (
              hasActiveAdminInvite()
              && incoming().occupied == true
              && incoming().adminUid == request.auth.uid
              && incoming().adminEmail is string
              && incoming().adminEmail.lower() == request.auth.token.email.lower()
            )
          ))
      );

      allow update: if isVerified() && (
        (docId == 'config'
          && isOwner()
          && isValidSystemConfig(incoming())
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'lowStockAlertEnabled', 'updatedAt']))
        ||
        (docId == 'adminSlot'
          && isValidAdminSlot(incoming())
          && incoming().updatedAt == request.time
          && (
            (isOwner()
              && incoming().diff(existing()).affectedKeys().hasOnly(['occupied', 'adminUid', 'adminEmail', 'updatedAt'])
              && (
                !existing().occupied ||
                !incoming().occupied ||
                incoming().adminEmail == existing().adminEmail
              ))
            ||
            (!exists(/databases/$(database)/documents/system/config)
              && existsAfter(/databases/$(database)/documents/system/config)
              && getAfter(/databases/$(database)/documents/system/config).data.ownerUid == request.auth.uid
              && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER'
              && incoming().diff(existing()).affectedKeys().hasOnly(['occupied', 'adminUid', 'adminEmail', 'updatedAt']))
            ||
            (hasActiveAdminInvite()
              && existing().occupied == true
              && existing().adminEmail is string
              && existing().adminEmail.lower() == request.auth.token.email.lower()
              && (existing().adminUid == null || existing().adminUid == request.auth.uid)
              && incoming().occupied == true
              && incoming().adminUid == request.auth.uid
              && incoming().adminEmail == existing().adminEmail
              && incoming().diff(existing()).affectedKeys().hasOnly(['adminUid', 'updatedAt']))
          ))
      );
    }

    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isManager());
      allow list: if isVerified() && (isManager() || existing().uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Path A: First Owner initialization or bootstrapped Owner
          (userId == request.auth.uid
            && incoming().role == 'OWNER'
            && incoming().email.lower() == request.auth.token.email.lower()
            && (isBootstrappedOwner() || !exists(/databases/$(database)/documents/system/config)))
          ||
          // Path B: Claiming an Owner-provisioned invite matching verified email & role
          (userId == request.auth.uid
            && ('inviteId' in incoming())
            && isValidId(incoming().inviteId)
            && exists(/databases/$(database)/documents/userInvites/$(incoming().inviteId))
            && get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.active == true
            && get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.email.lower() == request.auth.token.email.lower()
            && get(/databases/$(database)/documents/userInvites/$(incoming().inviteId)).data.role == incoming().role
            && (
              incoming().role != 'ADMIN' ||
              (existsAfter(/databases/$(database)/documents/system/adminSlot)
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.occupied == true
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.adminEmail.lower() == request.auth.token.email.lower())
            ))
          ||
          // Path C: Owner directly registering a user document
          (isOwner()
            && (
              incoming().role != 'ADMIN' ||
              incoming().active == false ||
              (existsAfter(/databases/$(database)/documents/system/adminSlot)
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.occupied == true
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.adminEmail.lower() == incoming().email.lower())
            ))
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner()
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'department', 'active', 'updatedAt'])
            && (
              incoming().role != 'ADMIN' ||
              incoming().active == false ||
              (existsAfter(/databases/$(database)/documents/system/adminSlot)
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.occupied == true
                && (getAfter(/databases/$(database)/documents/system/adminSlot).data.adminUid == userId || getAfter(/databases/$(database)/documents/system/adminSlot).data.adminEmail.lower() == existing().email.lower()))
            ))
          ||
          (request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']))
        );

      allow delete: if isOwner()
        && isValidId(userId)
        && userId != request.auth.uid
        && existing().role != 'OWNER';
    }

    match /userInvites/{inviteId} {
      allow get: if isVerified() && isValidId(inviteId) && (
        isManager()
        || (resource == null && inviteId == myInviteId())
        || (resource != null && existing().email.lower() == request.auth.token.email.lower())
      );
      allow list: if isVerified() && (isManager() || existing().email.lower() == request.auth.token.email.lower());

      allow create: if isOwner()
        && isValidId(inviteId)
        && isValidUserInvite(incoming())
        && incoming().id == inviteId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().role != 'ADMIN' ||
          incoming().active == false ||
          (existsAfter(/databases/$(database)/documents/system/adminSlot)
            && getAfter(/databases/$(database)/documents/system/adminSlot).data.occupied == true
            && getAfter(/databases/$(database)/documents/system/adminSlot).data.adminEmail.lower() == incoming().email.lower())
        );

      allow update: if isVerified()
        && isValidId(inviteId)
        && isValidUserInvite(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner()
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'department', 'active', 'updatedAt'])
            && (
              incoming().role != 'ADMIN' ||
              incoming().active == false ||
              (existsAfter(/databases/$(database)/documents/system/adminSlot)
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.occupied == true
                && getAfter(/databases/$(database)/documents/system/adminSlot).data.adminEmail.lower() == existing().email.lower())
            ))
          ||
          (existing().email.lower() == request.auth.token.email.lower()
            && existing().active == true
            && incoming().claimedUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['claimedUid', 'updatedAt']))
        );

      allow delete: if isOwner() && isValidId(inviteId);
    }

    match /categories/{categoryId} {
      allow get: if isActiveStaff() && isValidId(categoryId);
      allow list: if isActiveStaff();
      allow create: if isManager()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isManager()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'description', 'active', 'updatedAt']);
      allow delete: if isOwner() && isValidId(categoryId);
    }

    match /units/{unitId} {
      allow get: if isActiveStaff() && isValidId(unitId);
      allow list: if isActiveStaff();
      allow create: if isOwner()
        && isValidId(unitId)
        && isValidUnit(incoming())
        && incoming().id == unitId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner()
        && isValidId(unitId)
        && isValidUnit(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'description', 'active', 'updatedAt']);
      allow delete: if isOwner() && isValidId(unitId);
    }

    match /suppliers/{supplierId} {
      allow get: if isManager() && isValidId(supplierId);
      allow list: if isManager();
      allow create: if isManager()
        && isValidId(supplierId)
        && isValidSupplier(incoming())
        && incoming().id == supplierId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isManager()
        && isValidId(supplierId)
        && isValidSupplier(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'contactPerson', 'phone', 'email', 'address', 'active', 'updatedAt']);
      allow delete: if isOwner() && isValidId(supplierId);
    }

    match /items/{itemId} {
      allow get: if isActiveStaff() && isValidId(itemId);
      allow list: if isActiveStaff();
      allow create: if isManager()
        && isValidId(itemId)
        && isValidItem(incoming())
        && incoming().id == itemId
        && incoming().createdByUid == request.auth.uid
        && incoming().currentStock == incoming().initialStock
        && incoming().hasTransactions == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && exists(/databases/$(database)/documents/units/$(incoming().unitId))
        && exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId));

      allow update: if isManager()
        && isValidId(itemId)
        && isValidItem(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Master fields edit (cannot directly overwrite currentStock via master edit)
          (incoming().currentStock == existing().currentStock
            && incoming().hasTransactions == existing().hasTransactions
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'barcode', 'name', 'categoryId', 'categoryName',
              'specification', 'unitId', 'unitName', 'minStock',
              'purchasePrice', 'supplierId', 'supplierName', 'active', 'updatedAt'
            ]))
          ||
          // Action 2: Stock movement via confirmed incoming/delivery/adjustment
          (incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'hasTransactions', 'updatedAt'])
            && incoming().currentStock >= 0
            && incoming().hasTransactions == true)
        );

      allow delete: if isOwner()
        && isValidId(itemId)
        && existing().hasTransactions == false;
    }

    match /itemCodes/{codeKey} {
      allow get: if isManager() && isValidId(codeKey);
      allow create: if isManager()
        && isValidId(codeKey)
        && isValidUniqueCodeLock(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/itemCodes/$(codeKey));
      allow update: if isManager()
        && isValidId(codeKey)
        && isValidUniqueCodeLock(incoming())
        && incoming().itemId == existing().itemId
        && incoming().createdAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['value', 'createdAt']);
      allow delete: if isManager() && isValidId(codeKey);
    }

    match /itemBarcodes/{barcodeKey} {
      allow get: if isManager() && isValidId(barcodeKey);
      allow create: if isManager()
        && isValidId(barcodeKey)
        && isValidUniqueCodeLock(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/itemBarcodes/$(barcodeKey));
      allow update: if isManager()
        && isValidId(barcodeKey)
        && isValidUniqueCodeLock(incoming())
        && incoming().itemId == existing().itemId
        && incoming().createdAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['value', 'createdAt']);
      allow delete: if isManager() && isValidId(barcodeKey);
    }

    match /incomingTransactions/{txId} {
      allow get: if isManager() && isValidId(txId);
      allow list: if isManager();
      allow create: if isManager()
        && isValidId(txId)
        && isValidIncomingTransaction(incoming())
        && incoming().id == txId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().status == 'DRAFT' || (incoming().confirmedByUid == request.auth.uid && incoming().confirmedAt == request.time))
        && exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId))
        && existsAfter(/databases/$(database)/documents/idempotencyKeys/$(incoming().idempotencyKey));

      allow update: if isManager()
        && isValidId(txId)
        && isValidIncomingTransaction(incoming())
        && incoming().id == existing().id
        && incoming().txNumber == existing().txNumber
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Edit Draft before confirmation
          (existing().status == 'DRAFT'
            && incoming().status == 'DRAFT'
            && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'supplierId', 'supplierName', 'items', 'totalAmount', 'notes', 'updatedAt']))
          ||
          // Confirm Draft -> Confirmed
          (existing().status == 'DRAFT'
            && incoming().status == 'CONFIRMED'
            && incoming().confirmedByUid == request.auth.uid
            && incoming().confirmedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'confirmedByUid', 'confirmedByName', 'confirmedAt', 'updatedAt']))
          ||
          // Mark Confirmed -> Reversed when reversal entry created
          (existing().status == 'CONFIRMED'
            && incoming().status == 'REVERSED'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
    }

    match /stockRequests/{requestId} {
      allow get: if isActiveStaff() && isValidId(requestId)
        && (isManager() || existing().requesterUid == request.auth.uid);
      allow list: if isActiveStaff()
        && (isManager() || existing().requesterUid == request.auth.uid);

      allow create: if isActiveStaff()
        && isValidId(requestId)
        && isValidStockRequest(incoming())
        && incoming().id == requestId
        && incoming().requesterUid == request.auth.uid
        && incoming().status == 'MENUNGGU_PERSETUJUAN'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isActiveStaff()
        && isValidId(requestId)
        && isValidStockRequest(incoming())
        && incoming().id == existing().id
        && incoming().requestNumber == existing().requestNumber
        && incoming().requesterUid == existing().requesterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && !(existing().status in ['SELESAI', 'DITOLAK', 'DIBATALKAN'])
        && (
          // Manager: Approve / Ready / Reject
          (isManager()
            && existing().status == 'MENUNGGU_PERSETUJUAN'
            && incoming().status in ['DISETUJUI', 'SIAP_DIAMBIL', 'DITOLAK']
            && (incoming().status != 'DITOLAK' || (incoming().rejectionReason is string && incoming().rejectionReason.size() >= 3))
            && incoming().approvedByUid == request.auth.uid
            && incoming().approvedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'items', 'approvedByUid', 'approvedByName',
              'approvedAt', 'rejectionReason', 'updatedAt'
            ]))
          ||
          // Manager: Update delivery progress (requires atomic delivery creation)
          (isManager()
            && existing().status in ['DISETUJUI', 'SIAP_DIAMBIL', 'DALAM_PROSES_PENGAMBILAN']
            && incoming().status in ['DALAM_PROSES_PENGAMBILAN', 'SELESAI']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'updatedAt']))
          ||
          // Requester or Manager: Cancel while still waiting
          ((isManager() || existing().requesterUid == request.auth.uid)
            && existing().status == 'MENUNGGU_PERSETUJUAN'
            && incoming().status == 'DIBATALKAN'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isActiveStaff()
        && isValidId(requestId)
        && existing().status in ['MENUNGGU_PERSETUJUAN', 'DISETUJUI', 'SIAP_DIAMBIL', 'DITOLAK', 'DIBATALKAN']
        && (
          isOwner()
          || (isAdmin() && existing().status in ['MENUNGGU_PERSETUJUAN', 'DITOLAK', 'DIBATALKAN'])
          || (existing().requesterUid == request.auth.uid && existing().status in ['MENUNGGU_PERSETUJUAN', 'DIBATALKAN'])
        );
    }

    match /deliveries/{deliveryId} {
      allow get: if isActiveStaff() && isValidId(deliveryId)
        && (isManager() || existing().requesterUid == request.auth.uid);
      allow list: if isActiveStaff()
        && (isManager() || existing().requesterUid == request.auth.uid);

      allow create: if isManager()
        && isValidId(deliveryId)
        && isValidDeliveryRecord(incoming())
        && incoming().id == deliveryId
        && incoming().deliveredByUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/stockRequests/$(incoming().requestId))
        && existsAfter(/databases/$(database)/documents/idempotencyKeys/$(incoming().idempotencyKey));
    }

    match /stockAdjustments/{adjId} {
      allow get: if isManager() && isValidId(adjId);
      allow list: if isManager();
      allow create: if isOwner()
        && isValidId(adjId)
        && isValidStockAdjustment(incoming())
        && incoming().id == adjId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/items/$(incoming().itemId))
        && existsAfter(/databases/$(database)/documents/idempotencyKeys/$(incoming().idempotencyKey));
    }

    match /stockLedgers/{ledgerId} {
      allow get: if isManager() && isValidId(ledgerId);
      allow list: if isManager();
      allow create: if isManager()
        && isValidId(ledgerId)
        && isValidStockLedgerEntry(incoming())
        && incoming().id == ledgerId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/items/$(incoming().itemId));
    }

    match /notifications/{notifId} {
      allow get: if isActiveStaff() && isValidId(notifId) && (
        isOwner()
        || (isAdmin() && (existing().targetRole == 'ADMIN' || existing().targetUid == request.auth.uid))
        || (isProduksi() && existing().targetUid == request.auth.uid)
      );
      allow list: if isActiveStaff() && (
        isOwner()
        || (isAdmin() && (existing().targetRole == 'ADMIN' || existing().targetUid == request.auth.uid))
        || (isProduksi() && existing().targetUid == request.auth.uid)
      );
      allow create: if isActiveStaff()
        && isValidId(notifId)
        && isValidNotification(incoming())
        && incoming().id == notifId
        && incoming().createdAt == request.time;
      allow update: if isActiveStaff()
        && isValidId(notifId)
        && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && (
          isOwner()
          || (isAdmin() && (existing().targetRole == 'ADMIN' || existing().targetUid == request.auth.uid))
          || (isProduksi() && existing().targetUid == request.auth.uid)
        )
        && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'readAtBy'])
        && incoming().readBy.hasAll(existing().readBy)
        && request.auth.uid in incoming().readBy
        && incoming().readAtBy is map
        && request.auth.uid in incoming().readAtBy
        && incoming().readAtBy[request.auth.uid] == request.time
        && (
          ('readAtBy' in existing() && existing().readAtBy is map && incoming().readAtBy.diff(existing().readAtBy).affectedKeys().hasOnly([request.auth.uid]))
          || ((!('readAtBy' in existing()) || !(existing().readAtBy is map)) && incoming().readAtBy.keys().hasOnly([request.auth.uid]))
        );
      allow delete: if isActiveStaff() && isValidId(notifId) && (
        isOwner()
        || (isAdmin() && (existing().targetRole == 'ADMIN' || existing().targetUid == request.auth.uid))
        || (isProduksi() && existing().targetUid == request.auth.uid)
      );
    }

    match /auditLogs/{logId} {
      allow get: if isOwner() && isValidId(logId);
      allow list: if isOwner();
      allow create: if isVerified()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
    }

    match /idempotencyKeys/{key} {
      allow get: if isManager() && isValidId(key);
      allow create: if isManager()
        && isValidId(key)
        && isValidIdempotencyKey(incoming())
        && incoming().key == key
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/idempotencyKeys/$(key));
    }
  }
}
